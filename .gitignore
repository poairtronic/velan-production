# ==============================================================================
# Velan Production — Root .gitignore
# Language / Framework: Java 21 + Spring Boot 3.4.x | React 19 + Vite 6 + TypeScript
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
# Never commit actual environment files containing credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly preserve the example template
!.env.example

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*~
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Backend: Java & Maven (backend/)
# ------------------------------------------------------------------------------
target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Frontend: Node, Vite, React & TypeScript (frontend/)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.tsbuildinfo
*.local
.eslintcache
.stylelintcache
.npm/

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# Docker Local Overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
.docker/
