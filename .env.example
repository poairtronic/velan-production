# ==============================================================================
# Velan Production — Environment Configuration Template
# Phase 6.2 Baseline Template (Placeholders only; no secrets or real credentials)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot 4.0.x / Java 21)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=local
TZ=UTC
LOG_LEVEL=DEBUG
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256_BIT_SECRET_KEY_HERE

# Database Connectivity (PostgreSQL 16 on Neon)
# Application runtime uses the connection pooler endpoint (-pooler hostname, port 5432)
DATABASE_URL=jdbc:postgresql://ep-xxx-pooler.ap-southeast-1.aws.neon.tech:5432/velan_production?sslmode=require
DB_USER=velan_app
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX_SIZE=5
# Administrative migrations (Flyway, Phase 7) use the direct endpoint (port 5432) and dedicated migration credentials
DATABASE_DIRECT_URL=jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech:5432/velan_production?sslmode=require
FLYWAY_USER=velan_migrator
FLYWAY_PASSWORD=CHANGE_ME_MIGRATOR

# ------------------------------------------------------------------------------
# Frontend Configuration (React 19 / Vite 6)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# Later Phase Placeholders (Cloudflare R2, SMTP, RM & ECR Integrations)
# ------------------------------------------------------------------------------
# R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com   # later phase
# R2_BUCKET=velan-production-drawings                      # later phase
# R2_ACCESS_KEY=CHANGE_ME                                  # later phase
# R2_SECRET_KEY=CHANGE_ME                                  # later phase
# SMTP_HOST=smtp.example.com                               # later phase
# SMTP_USER=CHANGE_ME                                      # later phase
# SMTP_PASSWORD=CHANGE_ME                                  # later phase
# RM_API_BASE_URL=https://rm.example.com/api               # later phase
# RM_API_TOKEN=CHANGE_ME                                   # later phase
# ECR_API_BASE_URL=https://ecr.example.com/api             # later phase
# ECR_API_TOKEN=CHANGE_ME                                  # later phase
