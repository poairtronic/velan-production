# ==============================================================================
# Velan Production — Environment Configuration Template
# Phase 4.1 Root Baseline Template (Placeholders only; no secrets or real credentials)
# Note: Full environment configuration profiles will be established in Phase 6.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot 3.4.x / Java 21)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Connectivity (PostgreSQL 16 on Neon)
# Application runtime uses the connection pooler endpoint (-pooler hostname, port 5432)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech:5432/velan_production?sslmode=require
# Administrative migrations (Flyway, Phase 7) use the direct endpoint (port 5432)
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech:5432/velan_production?sslmode=require

# ------------------------------------------------------------------------------
# Frontend Configuration (React 19 / Vite 6)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
